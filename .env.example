# Copy to .env.local and fill in. Vite exposes every VITE_* variable to the browser bundle,
# so never put credentials, tokens or private keys here. Keep this template free of real values.

# Google Apps Script web app URL (Deploy > Manage deployments > Web app URL).
# Leave empty to run the experiment without central data collection; the summary screen
# then says so and only the per-session CSV download is available.
VITE_GOOGLE_SHEETS_WEB_APP_URL=

# Optional: load the stimuli from another location instead of /media/Video.mp4 and
# /media/virtual-reality-audio.m4a in public/ (for example when the host does not fetch Git LFS files).
VITE_VIDEO_URL=
VITE_AUDIO_URL=
